rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // HELPER FUNCTIONS
    // ==============================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isApprovedSeller() {
      return signedIn()
        && userDoc().data.role == "seller"
        && userDoc().data.status == "approved";
    }


    // ==============================
    // USERS
    // ==============================

    match /users/{userId} {

      // Anyone can read basic seller/buyer profile information
      // once signed in.
      allow read: if signedIn();

      // A user can create their own account.
      allow create: if isOwner(userId);

      // Users can update their own profile,
      // but cannot change their role or verification status.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;

      // Only the administrator can delete accounts.
      allow delete: if isAdmin();
    }


    // ==============================
    // SELLER APPLICATIONS
    // ==============================

    match /sellerApplications/{applicationId} {

      // Applicant can create their own application.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Applicant can see their own application.
      // Admin can see every application.
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Only admin can approve/reject applications.
      allow update, delete: if isAdmin();
    }


    // ==============================
    // PRODUCTS
    // ==============================

    match /products/{productId} {

      // Products can be viewed by signed-in buyers/sellers.
      allow read: if signedIn();

      // Only approved sellers can publish products.
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid;

      // Seller can edit only their own product.
      allow update: if isApprovedSeller()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId;

      // Seller can delete their own product.
      // Admin can delete any product.
      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
        );
    }


    // ==============================
    // FOLLOWING SELLERS
    // ==============================

    match /follows/{followId} {

      // A buyer can create their own follow.
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid;

      // Buyer can view their follows.
      allow read: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      // Buyer can unfollow.
      allow delete: if signedIn()
        && resource.data.buyerId == request.auth.uid;

      allow update: if false;
    }


    // ==============================
    // MESSAGES
    // ==============================

    match /messages/{messageId} {

      // A message can only be created by the sender.
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;

      // Only sender or receiver can read a message.
      allow read: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      // Sender can update their own message.
      allow update: if signedIn()
        && resource.data.senderId == request.auth.uid;

      // Sender can delete their own message.
      allow delete: if signedIn()
        && resource.data.senderId == request.auth.uid;
    }


    // ==============================
    // REPORTS
    // ==============================

    match /reports/{reportId} {

      // Signed-in users can submit reports.
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid;

      // Users can see their own reports.
      // Admin can see all reports.
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.reportedBy == request.auth.uid
        );

      // Only admin can modify or delete reports.
      allow update, delete: if isAdmin();
    }


    // ==============================
    // WISHLIST
    // ==============================

    match /wishlists/{wishlistId} {

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }


    // ==============================
    // CATEGORIES
    // ==============================

    match /categories/{categoryId} {

      // Everyone signed in can see categories.
      allow read: if signedIn();

      // Only admin can manage categories.
      allow create, update, delete: if isAdmin();
    }


    // ==============================
    // EVERYTHING ELSE
    // ==============================

    // Anything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
